# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://klusraak:klusraak@localhost:5432/klusraak?schema=public

# Cache / coordination
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-me-in-production-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-in-production-too-and-keep-it-different
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Cache TTLs (seconds)
CACHE_TTL_CATEGORIES=3600
CACHE_TTL_FEED=30
CACHE_TTL_JOB=60
CACHE_TTL_USER=120
CACHE_TTL_IDEMPOTENCY=86400

# Worker
WORKER_CONCURRENCY=5
