# Production environment template — set these via `fly secrets set ...`.
# Never commit real secrets.

# --- Server ---
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed origins for CORS. Set to your Netlify
# URL after the first frontend deploy.
CORS_ORIGIN=https://klusraak.netlify.app

# --- Database (Neon) ---
# Pooled URL via pgbouncer for the API + worker. Cap connections per
# replica so we don't exhaust the database.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/klusraak?sslmode=require&pgbouncer=true&connection_limit=10

# Direct (unpooled) URL for migrations. Prisma's migrate engine uses
# prepared statements that pgbouncer transaction-pooling rejects.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/klusraak?sslmode=require

# --- Cache / coordination (Upstash) ---
# Use the rediss:// (TLS) endpoint, not redis://.
REDIS_URL=rediss://default:PASSWORD@regional-host.upstash.io:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Cache TTLs (seconds) ---
CACHE_TTL_CATEGORIES=3600
CACHE_TTL_FEED=30
CACHE_TTL_JOB=60
CACHE_TTL_USER=120
CACHE_TTL_IDEMPOTENCY=86400

# --- Worker ---
WORKER_CONCURRENCY=5
